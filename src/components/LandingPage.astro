---
import logo from "../assets/visionxairy-icon.svg?raw";
---

<main class="flex flex-1 items-center justify-center">
  <div class="prose text-center px-4">
    <div
      class="w-24 h-24 mx-auto mb-4 text-base-content [&>svg]:w-full [&>svg]:h-full [&>svg]:fill-current"
      set:html={logo}
    />
    <h1 class="mb-2">VisionXAiRy</h1>
    <p class="lead mt-0 mb-8">
      Human-Centered AI, XR, and Digital Innovation
    </p>
    <a href="/about" class="btn btn-primary">
      Discover Our Vision
    </a>
  </div>
</main>